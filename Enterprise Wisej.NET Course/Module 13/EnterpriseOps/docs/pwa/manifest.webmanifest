{
  "name": "EnterpriseOps — Field Technician mode",
  "short_name": "EnterpriseOps Field",
  "description": "Field service work orders for Contoso Utilities. Works with no signal: completions are queued on the device and replayed when the connection returns.",
  "id": "/enterpriseops-field/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait-primary",
  "background_color": "#eef2f7",
  "theme_color": "#0f2440",
  "lang": "en",
  "dir": "ltr",
  "categories": ["business", "productivity", "utilities"],
  "prefer_related_applications": false,
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    {
      "name": "My work orders",
      "short_name": "Work orders",
      "description": "The work orders cached on this device",
      "url": "/?view=field",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }]
    }
  ]
}
