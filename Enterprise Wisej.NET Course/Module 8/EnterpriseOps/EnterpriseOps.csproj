<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    EnterpriseOps — Enterprise Wisej.NET course lab (EnterpriseOps Command Center).
    Multi-targets net10.0-windows and net10.0 (Kestrel). Run with:
      dotnet run -f net10.0 -&#45;urls http://localhost:52NN (Module N → 5200+N)   (from this folder)
  -->
  <PropertyGroup>
    <TargetFrameworks>net10.0-windows;net10.0</TargetFrameworks>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EmbeddedResourceUseDependentUponConvention>true</EmbeddedResourceUseDependentUponConvention>
    <RootNamespace>EnterpriseOps</RootNamespace>
    <NoWarn>CA1416;WFO1000;CS7022</NoWarn>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <!--
    The embedded resource package of the component library (Widgets/ComponentResourcePackage.cs).
    The assembly is the source of truth: referencing it brings the vendor library, the component
    stylesheet and the client adapter with it. The first two are ALSO served from Widgets/ because a
    Widget package is fetched over HTTP; ComponentResourcePackage.Verify() compares the two copies so
    a hand-edited served file is reported instead of silently shipping.
  -->
  <ItemGroup>
    <None Remove="Widgets\vendor-opschart.js" />
    <None Remove="Widgets\opschart.css" />
    <None Remove="Widgets\opschart-init.js" />
    <EmbeddedResource Include="Widgets\vendor-opschart.js" LogicalName="EnterpriseOps.Widgets.vendor-opschart.js" />
    <EmbeddedResource Include="Widgets\opschart.css" LogicalName="EnterpriseOps.Widgets.opschart.css" />
    <EmbeddedResource Include="Widgets\opschart-init.js" LogicalName="EnterpriseOps.Widgets.opschart-init.js" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="Default.json">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Content>
    <Content Update="Web.config">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <None Remove="Default.html" />
    <None Remove="favicon.ico" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Default.html">
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Wisej-4" Version="4.1.0" />
  </ItemGroup>

</Project>
