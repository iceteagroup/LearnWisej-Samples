{
  "//": "Developer machine: everything local, nothing secret (a local database with integrated security, a stub identity provider).",
  "EnterpriseOps": {
    "Release": {
      "NodeName": "dev-box"
    },
    "ConnectionString": "Server=(localdb)\\MSSQLLocalDB;Database=EnterpriseOps;Integrated Security=true",
    "Logging": {
      "Level": "Debug"
    },
    "UploadLimitMb": 100,
    "FeatureFlags": "all-on",
    "IdentityProvider": {
      "Authority": "https://localhost:5212/dev-stub",
      "ClientId": "enterpriseops-dev",
      "ClientSecret": "dev-only-not-a-secret"
    },
    "AllowedHosts": "*"
  }
}
