{
  "//": "Base layer of the configuration contract. Environment files override; environment variables override both. No secrets here — ever.",
  "EnterpriseOps": {
    "Release": {
      "Version": "2.4.2",
      "PreviousVersion": "2.4.1",
      "NodeName": "app-node-A"
    },
    "Logging": {
      "Level": "Information"
    },
    "UploadLimitMb": 25,
    "FeatureFlags": "release-set",
    "IdentityProvider": {
      "Authority": "",
      "ClientId": "enterpriseops",
      "ClientSecret": ""
    },
    "AllowedHosts": "*",
    "Storage": {
      "Root": "./_storage"
    },
    "ReverseProxy": {
      "TrustForwardedHeaders": true
    }
  }
}
