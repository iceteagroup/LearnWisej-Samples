<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    EnterpriseOps — Enterprise Wisej.NET course lab (EnterpriseOps Command Center).
    Multi-targets net10.0-windows and net10.0 (Kestrel). Run with:
      dotnet run -f net10.0 -&#45;urls http://localhost:52NN (Module N → 5200+N)   (from this folder)
  -->
  <PropertyGroup>
    <TargetFrameworks>net10.0-windows;net10.0</TargetFrameworks>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EmbeddedResourceUseDependentUponConvention>true</EmbeddedResourceUseDependentUponConvention>
    <RootNamespace>EnterpriseOps</RootNamespace>
    <NoWarn>CA1416;WFO1000;CS7022</NoWarn>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!--
      The widget's client adapter ships INSIDE the assembly: CommandPaletteHost hands it to the
      widget as InitScript via GetResourceString("EnterpriseOps.Interop.command-palette-host.js").
      The palette library itself is NOT embedded — it is a Widget Package served as a static file
      from the project folder (/Interop/palette.client.js), so a reviewer can open it in the
      browser's dev tools and confirm it contains no business rule.
    -->
    <None Remove="Interop\command-palette-host.js" />
    <EmbeddedResource Include="Interop\command-palette-host.js" LogicalName="EnterpriseOps.Interop.command-palette-host.js" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="Default.json">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Content>
    <Content Update="Web.config">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <None Remove="Default.html" />
    <None Remove="favicon.ico" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Default.html">
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Wisej-4" Version="4.1.0" />
  </ItemGroup>

</Project>
