<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    AccessOps - Security & Auth Patterns course lab (one solution per module).
    Run with:  dotnet run -f net10.0 with urls http://localhost:640N   (N = module number)
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <!-- true from Module 6 on: the generated assembly info carries the UserSecretsId attribute that
         WebApplication.CreateBuilder reads to load user secrets in Development. -->
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <RootNamespace>AccessOps</RootNamespace>
    <NoWarn>CA1416;WFO1000;CS7022</NoWarn>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- Development secrets (connection string, OIDC client secret, share-link key) live in the
         user's profile under this id, outside the repository. See the module README. -->
    <UserSecretsId>accessops-security-course-app</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <Content Update="Default.json">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Content>
    <Content Update="Web.config">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Content>
    <Content Update="Data\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <None Remove="Default.html" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Default.html">
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Wisej-4" Version="4.1.7" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.14" />
  </ItemGroup>

</Project>
