<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    AccessOps - Security & Auth Patterns course, Module 1 (Identity Boundaries).
    Run it from the module folder: see README.md (port 6401, http).

    Debug builds compile the training-only pieces (TestVerifier, IdentityDiagnosticsView,
    the identity trace). They sit inside #if DEBUG, so a Release build or publish does not
    contain them at all: there is nothing to hide behind a route.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <RootNamespace>AccessOps</RootNamespace>
    <NoWarn>CA1416;WFO1000;CS7022</NoWarn>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Content Update="Default.json">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Content>
    <Content Update="Web.config">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <None Remove="Default.html" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Default.html">
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Wisej-4" Version="4.1.7" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
  </ItemGroup>

</Project>
