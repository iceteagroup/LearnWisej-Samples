{
  "AccessOps": {
    "DataRoot": "../AccessOpsData",
    "AllowedOrigins": [ "https://localhost:6405" ],
    "ReturnUrlAllowlist": [ ]
  },
  "Oidc": {
    "_comment": "No secret here: Oidc:ClientSecret comes from user secrets (Development) or the Oidc__ClientSecret environment variable. RequireHttpsMetadata is false only because the lab's test provider runs on http://localhost; keep it true for any real provider.",
    "Authority": "http://localhost:6415",
    "ClientId": "accessops",
    "CallbackPath": "/signin-oidc",
    "Scopes": [ "openid", "profile", "email" ],
    "RequireHttpsMetadata": false,
    "ProviderName": "Contoso Identity"
  },
  "Hosting": {
    "KnownProxies": [ "127.0.0.1", "::1" ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Authentication": "Error"
    }
  }
}
