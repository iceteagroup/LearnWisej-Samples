<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    AccessOps - Security & Auth Patterns course, Module 5 (Federation with OpenID Connect).
    The partner route: OpenID Connect federation in front of the Module 4 sign-in.
    Run it from the module folder: see README.md (https://localhost:6405, test IdP on 6415).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <!-- true from Module 5 on: the generated assembly attributes carry the UserSecretsId that
         WebApplication.CreateBuilder reads to load user secrets (Oidc:ClientSecret) in Development.
         The Wisej.NET template's "false" silently drops them. -->
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <UserSecretsId>accessops-security-course-partner</UserSecretsId>
    <RootNamespace>AccessOps</RootNamespace>
    <NoWarn>CA1416;WFO1000;CS7022</NoWarn>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Content Update="Default.json">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Content>
    <Content Update="Web.config">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <None Remove="Default.html" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Default.html">
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Wisej-4" Version="4.1.7" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.14" />
  </ItemGroup>

</Project>
