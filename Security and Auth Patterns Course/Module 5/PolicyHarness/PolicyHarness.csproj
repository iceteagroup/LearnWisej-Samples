<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Self-contained policy harness (adapted from the course pack's code_snippets/PolicyHarness).
    Plain .NET: no Wisej.NET, no IIS, no identity provider. The pack targets net8.0; the course
    labs run on net10.0, and the harness behaves the same on both.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

</Project>
