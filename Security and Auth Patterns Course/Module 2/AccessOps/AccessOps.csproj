<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    AccessOps - Security & Auth Patterns course, Module 2 (IIS and Browser Integrated
    Authentication): the intranet route behind Windows sign-in.
    Run it from the module folder: see README.md (port 6402, http).

    On this machine Windows sign-in is the Kestrel Negotiate handler
    (Microsoft.AspNetCore.Authentication.Negotiate, a NuGet package, not part of the shared
    framework). Under IIS the same code receives the principal from IIS Windows Authentication
    (iis/windows-auth.location.xml, docs/iis-publish-and-rollback.md).

    Debug builds compile the training-only pieces (IdentityDiagnosticsView, the identity trace).
    They sit inside #if DEBUG, so a Release build or publish does not contain them at all.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <RootNamespace>AccessOps</RootNamespace>
    <NoWarn>CA1416;WFO1000;CS7022</NoWarn>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Content Update="Default.json">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Content>
    <Content Update="Web.config">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <None Remove="Default.html" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Default.html">
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Wisej-4" Version="4.1.7" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Negotiate" Version="10.0.14" />
  </ItemGroup>

</Project>
