{
  "AccessOps": {
    "DataRoot": "../AccessOpsData"
  },
  "Oidc": {
    "_comment": "External sign-in (OpenID Connect, authorization code + PKCE). The client secret is NOT here: it comes from configuration supplied by the environment (Oidc__ClientSecret).",
    "ProviderName": "Contoso Identity",
    "Authority": "http://localhost:6414",
    "ClientId": "accessops",
    "Scopes": [ "openid", "profile", "email", "offline_access", "hr.read" ],
    "HrProfileUrl": "http://localhost:6414/api/hr/profile"
  },
  "Permissions": {
    "_comment": "Role -> permission map. A new role, or a role that gains a permission, is a change here - not in forty screens.",
    "Roles": {
      "Employee": [ "ViewDepartmentDocuments", "SubmitRequest" ],
      "Manager": [ "ViewDepartmentDocuments", "SubmitRequest", "ApproveRequest" ],
      "DepartmentAdmin": [ "ViewDepartmentDocuments", "UploadDocument", "ManageUsers" ],
      "Auditor": [ "ViewAllDocuments", "ViewAuditTrail" ],
      "Administrator": [ "ViewAllDocuments", "ManageUsers", "ViewAuditTrail" ]
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
