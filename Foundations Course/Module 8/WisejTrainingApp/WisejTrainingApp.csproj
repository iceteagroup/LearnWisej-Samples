<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    WisejTrainingApp — Wisej.NET Foundations course lab.
    Multi-targets net10.0-windows and net10.0 (Kestrel). Run with:
      dotnet run -f net10.0 -&#45;urls http://localhost:5088   (from this folder)
  -->
  <PropertyGroup>
    <TargetFrameworks>net10.0-windows;net10.0</TargetFrameworks>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EmbeddedResourceUseDependentUponConvention>true</EmbeddedResourceUseDependentUponConvention>
    <RootNamespace>WisejTrainingApp</RootNamespace>
    <NoWarn>CA1416;WFO1000;CS7022</NoWarn>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Content Update="Default.json">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Content>
    <Content Update="Web.config">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <None Remove="Default.html" />
    <None Remove="favicon.ico" />
    <None Remove="Widgets\statusGauge.js" />
    <None Remove="Widgets\statusGauge.css" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Default.html">
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
    <!--
      Module 8: the widget files are plain static files, NOT embedded resources.
      Startup.cs serves the project folder, so the browser fetches /Widgets/statusGauge.css
      (Widget.Package.Source = "Widgets/statusGauge.css") and StatusPage_Load reads
      Widgets/statusGauge.js from disk with Application.MapPath + File.ReadAllText.
    -->
    <Content Include="Widgets\statusGauge.js">
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
    <Content Include="Widgets\statusGauge.css">
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Wisej-4" Version="4.1.0" />
  </ItemGroup>

</Project>
