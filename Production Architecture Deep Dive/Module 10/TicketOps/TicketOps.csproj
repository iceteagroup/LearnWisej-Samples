<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    TicketOps: Production Architecture Deep Dive, Module 10 lab (the TicketOps Console —
    theming, resources, localization & UI modernization).
    Multi-targets net10.0-windows and net10.0 (Kestrel). Run from this folder with
    "dotnet run -f net10.0" plus the urls switch set to http://localhost:5110 (exact command in the README).
  -->
  <PropertyGroup>
    <TargetFrameworks>net10.0-windows;net10.0</TargetFrameworks>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EmbeddedResourceUseDependentUponConvention>true</EmbeddedResourceUseDependentUponConvention>
    <RootNamespace>TicketOps</RootNamespace>
    <NoWarn>CA1416;WFO1000;CS7022</NoWarn>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Localized text. The neutral file compiles into the main assembly as TicketOps.Resources.Strings.resources;
      Strings.de.resx becomes the satellite assembly de\TicketOps.resources.dll. The ResourceManager in
      Resources/Strings.cs uses exactly this base name, so the names are pinned here instead of inferred.
    -->
    <EmbeddedResource Update="Resources\Strings.resx">
      <LogicalName>TicketOps.Resources.Strings.resources</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\Strings.de.resx">
      <LogicalName>TicketOps.Resources.Strings.de.resources</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <!-- Theme mixin (the StatusChip appearance): read from the app's /Themes folder and merged into the active theme. -->
    <None Remove="Themes\**" />
    <Content Include="Themes\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="Default.json">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Content>
    <Content Update="Web.config">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <None Remove="Default.html" />
    <None Remove="favicon.ico" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Default.html">
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Wisej-4" Version="4.1.0" />
  </ItemGroup>

</Project>
