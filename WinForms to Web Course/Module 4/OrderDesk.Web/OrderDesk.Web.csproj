<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    OrderDesk.Web — From WinForms to the Web, Module N lab (the migrated LegacyOrderDesk).
    Multi-targets net10.0-windows;net10.0 (Kestrel). Run from this folder with:
      dotnet run -f net10.0 (Properties/launchSettings.json sets the port 510N)
  -->
  <PropertyGroup>
    <TargetFrameworks>net10.0-windows;net10.0</TargetFrameworks>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EmbeddedResourceUseDependentUponConvention>true</EmbeddedResourceUseDependentUponConvention>
    <RootNamespace>OrderDesk</RootNamespace>
    <AssemblyName>OrderDesk</AssemblyName>
    <NoWarn>CA1416;WFO1000;CS7022</NoWarn>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Content Update="Default.json">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Content>
    <Content Update="Web.config">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <None Remove="Default.html" />
    <None Remove="favicon.ico" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Default.html">
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Wisej-4" Version="4.1.0" />
  </ItemGroup>

</Project>
