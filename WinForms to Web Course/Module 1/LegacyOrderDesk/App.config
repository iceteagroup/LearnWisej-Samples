<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <!-- Desktop configuration: the Module 2 port moves these into Web.config / appsettings. -->
  <appSettings>
    <add key="ExportFolder" value="C:\Orders" />
    <add key="ReportPrinter" value="(default)" />
  </appSettings>
  <connectionStrings>
    <add name="OrderDesk" connectionString="Server=LAN-SQL01;Database=OrderDesk;Trusted_Connection=True;" providerName="System.Data.SqlClient" />
  </connectionStrings>
</configuration>
