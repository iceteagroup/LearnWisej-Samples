{
  "url": "Default.html",
  "startup": "GlobalDesk.Program.Main, GlobalDesk",
  "theme": "Bootstrap-4",
  "debug": true,
  "sessionTimeout": 1800,

  // "auto" starts each session from the browser's Accept-Language; ?lang= overrides it for one
  // session. See Module 4 for when to pin a fixed culture instead.
  "culture": "auto",

  // Module 5. "auto" makes the session right-to-left when its culture is - Arabic, Hebrew,
  // Persian, Urdu - without the application testing for a list of languages it will get wrong.
  // Controls inherit it, so a screen is mirrored by leaving them alone rather than by setting a
  // property on each one.
  "rightToLeft": "auto"
}
