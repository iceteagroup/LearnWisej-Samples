<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    SupportDesk.Web — Data Binding with EF Core, Module 1 lab (Support Desk Data Console).
    Multi-targets net10.0-windows;net10.0 (Kestrel). Run with:
      dotnet run -f net10.0 [urls flag] http://localhost:5401   (from this folder; the exact command is in the README)
  -->
  <PropertyGroup>
    <TargetFrameworks>net10.0-windows;net10.0</TargetFrameworks>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EmbeddedResourceUseDependentUponConvention>true</EmbeddedResourceUseDependentUponConvention>
    <RootNamespace>SupportDesk.Web</RootNamespace>
    <NoWarn>CA1416;WFO1000;CS7022</NoWarn>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Content Update="Default.json">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Content>
    <Content Update="Web.config">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <None Remove="Default.html" />
    <None Remove="favicon.ico" />
    <None Remove="App_Data\**" />
    <Content Remove="App_Data\**" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Default.html">
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Wisej-4" Version="4.1.0" />
    <!-- Tooling only, so dotnet ef can use SupportDesk.Web as its startup project. The provider packages stay in SupportDesk.Data. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SupportDesk.Data\SupportDesk.Data.csproj" />
    <ProjectReference Include="..\SupportDesk.Services\SupportDesk.Services.csproj" />
  </ItemGroup>

</Project>
