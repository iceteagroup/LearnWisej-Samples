<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    FieldOps - Hybrid & Native Packaging course lab (one solution per module).
    The Wisej.NET web application: the same project every client opens - a browser tab, the
    installed PWA and, from Module 3 on, the Wisej.NET Hybrid client.
    Multi-targets net10.0-windows and net10.0 (Kestrel). Run with:
      dotnet run -f net10.0 with urls http://localhost:630N   (from this folder; N = module number)
  -->
  <PropertyGroup>
    <TargetFrameworks>net10.0-windows;net10.0</TargetFrameworks>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EmbeddedResourceUseDependentUponConvention>true</EmbeddedResourceUseDependentUponConvention>
    <RootNamespace>FieldOps</RootNamespace>
    <NoWarn>CA1416;WFO1000;CS7022</NoWarn>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Content Update="Default.json">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Content>
    <Content Update="Web.config">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <None Remove="Default.html" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="sw.js;offline.html;manifest.webmanifest;icons\**" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Default.html">
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
    <!-- The PWA shell: plain static files in the web root, published with the app. -->
    <Content Include="sw.js;offline.html;manifest.webmanifest;icons\**">
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Wisej-4" Version="4.1.7" />
    <!-- The server half of the package pair: Wisej.Hybrid.Device. The client half,
         Wisej-4-Hybrid-Native, goes into the MAUI client project (Module 3 on). -->
    <PackageReference Include="Wisej-4-Hybrid" Version="4.1.7" />
  </ItemGroup>

</Project>
