<?xml version="1.0"?>
<configuration>
	<appSettings>
		<!-- App.config settings from LegacyOrderDesk move here (Module 2). -->
		<add key="Wisej.LicenseKey" value=""/>
		<add key="Wisej.DefaultTheme" value="Bootstrap-4"/>
		<add key="OrderDesk.StorageRoot" value="App_Data"/>
	</appSettings>
	<connectionStrings>
		<!-- The desktop app read this from App.config with ConfigurationManager.ConnectionStrings["OrderDesk"];
		     the web host has no App.config, so the section lives here and Configuration/WebConfig.cs reads it with XDocument. -->
		<add name="OrderDesk" connectionString="Server=(local);Database=OrderDesk;User Id=orderdesk;Password=Sup3r-Secret!"/>
	</connectionStrings>
</configuration>
