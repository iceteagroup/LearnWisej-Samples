<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    OrderDesk.Web — the Wisej.NET 4 web project that LegacyOrderDesk migrates into
    ("From WinForms to the Web" course labs).
    Multi-targets net10.0-windows and net10.0 (Kestrel). Run with:
      dotnet run -f net10.0 -\-urls http://localhost:560N   (from this folder; Module N listens on 5600 + N)
  -->
  <PropertyGroup>
    <TargetFrameworks>net10.0-windows;net10.0</TargetFrameworks>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EmbeddedResourceUseDependentUponConvention>true</EmbeddedResourceUseDependentUponConvention>
    <RootNamespace>OrderDesk</RootNamespace>
    <AssemblyName>OrderDesk</AssemblyName>
    <NoWarn>CA1416;WFO1000;CS7022</NoWarn>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Content Update="Default.json">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Content>
    <Content Update="Web.config">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!--
      Legacy\WinForms holds the System.Windows.Forms sources this module ports (OrdersForm, EditOrderDialog,
      SettingsForm). They sit next to their Wisej.NET replacements for side-by-side reading and are NOT
      compiled: the web project never references System.Windows.Forms.
    -->
    <Compile Remove="Legacy\WinForms\**" />
    <None Include="Legacy\WinForms\**" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Default.html" />
    <None Remove="favicon.ico" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Default.html">
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Wisej-4" Version="4.1.0" />
  </ItemGroup>

</Project>
