<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    OrderDesk.Web — the Wisej.NET 4 web project that LegacyOrderDesk migrated into
    ("From WinForms to the Web" course labs). Module 7: the modernized, secured, deployable capstone.
    Multi-targets net10.0-windows and net10.0 (Kestrel). Run with:
      dotnet run -f net10.0 -\-urls http://localhost:5607   (from this folder)
  -->
  <PropertyGroup>
    <TargetFrameworks>net10.0-windows;net10.0</TargetFrameworks>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EmbeddedResourceUseDependentUponConvention>true</EmbeddedResourceUseDependentUponConvention>
    <RootNamespace>OrderDesk</RootNamespace>
    <AssemblyName>OrderDesk</AssemblyName>
    <NoWarn>CA1416;WFO1000;CS7022</NoWarn>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Content Update="Default.json">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Content>
    <Content Update="Web.config">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Content>
    <!--
      Module 7: the custom client profiles. The Web SDK already lists every *.json file as Content, so this
      is an Update. The framework reads ClientProfiles.json next to the assembly, hence the copy for both
      target frameworks; Startup.cs never serves *.json, so the file is not downloadable.
    -->
    <Content Update="ClientProfiles.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!-- Module 7: the theme mixin, merged into the active theme at runtime (read from the app's /Themes folder). -->
    <Content Include="Themes\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!--
      deploy/ holds deployment assets (an IIS web.config, a Dockerfile, a publish profile as text). The Web SDK
      would otherwise pick deploy/iis/web.config up as Content; they are documentation for the target host, not
      part of this build.
    -->
    <Content Remove="deploy\**" />
    <None Include="deploy\**" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Default.html" />
    <None Remove="favicon.ico" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Default.html">
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Wisej-4" Version="4.1.0" />
  </ItemGroup>

</Project>
