<?xml version="1.0" encoding="utf-8"?>
<!--
  OrderDesk.Web · IIS deployment web.config (Module 7).

  This file REPLACES the project's Web.config in the publish folder on an IIS host: it carries both halves —
  the <appSettings> the application and Wisej.NET read (AppConfig / Wisej.*), and the ASP.NET Core Module
  handler that tells IIS to start "dotnet OrderDesk.dll" in-process. Publish, then copy this file over
  <publish>\web.config and fill in the values marked TODO. Requires the ASP.NET Core Hosting Bundle (.NET 10)
  on the server; the site's application pool runs "No Managed Code".

  Session affinity: Wisej.NET keeps the session state in the process, so behind a web farm / ARR the load
  balancer must pin a browser to one instance (sticky sessions / client affinity). See docs/DeploymentChecklist.md.
-->
<configuration>
  <appSettings>
    <!-- TODO production: the Wisej.NET license key for this server (never commit it — set it at deploy time). -->
    <add key="Wisej.LicenseKey" value="" />
    <add key="Wisej.DefaultTheme" value="Bootstrap-4" />
    <!-- Absolute path of the storage root on the server (App_Data: uploads, exports, reports, logs). The app-pool identity needs Modify rights. -->
    <add key="OrderDesk.StorageRoot" value="D:\OrderDeskData" />
    <add key="OrderDesk.ThemeMixin" value="orderdesk" />
    <add key="OrderDesk.Version" value="7.0.0-capstone" />
  </appSettings>

  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <!-- In-process hosting: IIS loads the CoreCLR into w3wp.exe. processPath "dotnet" + the published assembly. -->
      <aspNetCore processPath="dotnet"
                  arguments=".\OrderDesk.dll"
                  hostingModel="inprocess"
                  stdoutLogEnabled="true"
                  stdoutLogFile=".\logs\stdout"
                  startupTimeLimit="120"
                  shutdownTimeLimit="30">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
          <!-- Kestrel does not bind a port here: IIS forwards to the in-process host. -->
          <environmentVariable name="DOTNET_PRINT_TELEMETRY_MESSAGE" value="false" />
        </environmentVariables>
      </aspNetCore>
      <!-- Uploads (Module 6) are capped at 1 MB in the Upload control; keep the IIS limit close to it. -->
      <security>
        <requestFiltering>
          <requestLimits maxAllowedContentLength="10485760" />
        </requestFiltering>
      </security>
      <!-- Wisej.NET talks over WebSocket when it can (see "web socket" in the health check): enable the IIS WebSocket Protocol feature. -->
      <webSocket enabled="true" />
    </system.webServer>
  </location>
</configuration>
