<?xml version="1.0"?>
<configuration>
	<appSettings>
		<!-- App.config settings from LegacyOrderDesk moved here in Module 2. Module 7 adds the deployment values. -->
		<add key="Wisej.LicenseKey" value=""/>
		<add key="Wisej.DefaultTheme" value="Bootstrap-4"/>
		<!-- Relative to Application.StartupPath (the content root). In production point it at a mounted volume. -->
		<add key="OrderDesk.StorageRoot" value="App_Data"/>
		<!-- Name of the theme mixin file in /Themes (without .mixin.theme). -->
		<add key="OrderDesk.ThemeMixin" value="orderdesk"/>
		<!-- Shown by the health check and the readiness checklist. -->
		<add key="OrderDesk.Version" value="7.0.0-capstone"/>
	</appSettings>
</configuration>
