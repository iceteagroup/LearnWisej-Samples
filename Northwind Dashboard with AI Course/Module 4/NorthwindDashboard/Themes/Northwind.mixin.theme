    "nw-surface": "#ffffff",
    "nw-border": "#dce6f0",
    "nw-border-strong": "#c3cfdc",
    "nw-text": "#182c44",
    "nw-text-secondary": "#425974",
    "nw-muted": "#5e7289",
    "nw-subtle": "#8a9bb0",
    "nw-primary": "#1565d8",
    "nw-primary-hover": "#0f55bd",
    "nw-primary-soft": "#eaf3ff",
    "nw-primary-softer": "#f4f9ff",
    "nw-hover": "#e3ebf5",
    "chartview-neutral": "#64748b",
