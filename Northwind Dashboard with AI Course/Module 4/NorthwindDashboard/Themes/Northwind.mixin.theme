    "mapview-background": "#eaf1f8",
    "kpipanel-primary": "#1565d8",
    "kpipanel-border": "#dce6f0",
    "kpipanel-text": "#182c44",
    "kpipanel-muted": "#5e7289",
    "kpipanel-success": "#1f9d55",
    "kpipanel-danger": "#d64545",
    "chiplabel-primary": "#1565d8",
    "chiplabel-primary-soft": "#eaf3ff",
    "avatar-focus": "#1565d8"
