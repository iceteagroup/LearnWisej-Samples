  "appearances": {
    "nw-sidebar": {
      "inherit": "panel",
      "states": {
        "default": {
          "properties": {
            "backgroundColor": "nw-sidebar"
          },
          "styles": {
            "width": [
              0,
              1,
              0,
              0
            ],
            "style": "solid",
            "color": "nw-border",
            "radius": 0
          }
        }
      }
    },
    "nw-topbar": {
      "inherit": "panel",
      "states": {
        "default": {
          "properties": {
            "backgroundColor": "nw-surface"
          },
          "styles": {
            "width": [
              0,
              0,
              1,
              0
            ],
            "style": "solid",
            "color": "nw-border",
            "radius": 0
          }
        }
      }
    },
    "nw-content": {
      "inherit": "panel",
      "states": {
        "default": {
          "properties": {
            "backgroundColor": "nw-page"
          },
          "styles": {
            "width": 0,
            "radius": 0
          }
        }
      }
    },
    "nw-view": {
      "inherit": "panel",
      "states": {
        "default": {
          "properties": {
            "backgroundColor": "transparent"
          },
          "styles": {
            "width": 0,
            "radius": 0
          }
        }
      }
    },
    "nw-card": {
      "inherit": "panel",
      "states": {
        "default": {
          "properties": {
            "backgroundColor": "nw-surface",
            "textColor": "nw-text"
          },
          "styles": {
            "width": 1,
            "style": "solid",
            "color": "nw-border",
            "radius": 8
          }
        }
      },
      "components": {
        "captionbar": {
          "states": {
            "default": {
              "properties": {
                "textColor": "nw-text"
              },
              "styles": {
                "backgroundColor": "transparent",
                "radius": 0
              }
            },
            "horizontal": {
              "properties": {
                "height": 46
              }
            }
          }
        },
        "title": {
          "states": {
            "default": {
              "properties": {
                "font": "nw-card-title",
                "textColor": "nw-text"
              }
            },
            "horizontal": {
              "properties": {
                "margin": [
                  4,
                  16,
                  0,
                  16
                ]
              }
            }
          }
        }
      }
    },
    "nw-nav": {
      "inherit": "button",
      "states": {
        "default": {
          "properties": {
            "font": "nw-nav",
            "textColor": "nw-text-secondary",
            "padding": [
              0,
              12
            ],
            "center": false,
            "height": 36
          },
          "styles": {
            "backgroundColor": "transparent",
            "width": 0,
            "radius": 5
          }
        },
        "hovered": {
          "properties": {
            "textColor": "nw-text"
          },
          "styles": {
            "backgroundColor": "nw-hover"
          }
        }
      }
    },
    "nw-nav-active": {
      "inherit": "nw-nav",
      "states": {
        "default": {
          "properties": {
            "font": "nw-nav-active",
            "textColor": "white"
          },
          "styles": {
            "backgroundColor": "nw-primary"
          }
        },
        "hovered": {
          "properties": {
            "textColor": "white"
          },
          "styles": {
            "backgroundColor": "nw-primary"
          }
        }
      }
    },
    "nw-button": {
      "inherit": "button",
      "states": {
        "default": {
          "properties": {
            "font": "nw-body",
            "textColor": "nw-text",
            "padding": [
              0,
              12
            ],
            "height": 34
          },
          "styles": {
            "backgroundColor": "nw-surface",
            "width": 1,
            "style": "solid",
            "color": "nw-border-strong",
            "radius": 8
          }
        },
        "hovered": {
          "styles": {
            "backgroundColor": "nw-hover"
          }
        }
      }
    },
    "nw-button-primary": {
      "inherit": "button",
      "states": {
        "default": {
          "properties": {
            "font": "nw-body-strong",
            "textColor": "white",
            "padding": [
              0,
              14
            ],
            "height": 34
          },
          "styles": {
            "backgroundColor": "nw-primary",
            "width": 1,
            "style": "solid",
            "color": "nw-primary",
            "radius": 8
          }
        },
        "hovered": {
          "styles": {
            "backgroundColor": "nw-primary-hover",
            "color": "nw-primary-hover"
          }
        }
      }
    },
    "nw-icon-button": {
      "inherit": "button",
      "states": {
        "default": {
          "properties": {
            "textColor": "nw-text-secondary",
            "padding": 0,
            "center": true,
            "height": 40
          },
          "styles": {
            "backgroundColor": "transparent",
            "width": 0,
            "radius": 8
          }
        },
        "hovered": {
          "properties": {
            "textColor": "nw-text"
          },
          "styles": {
            "backgroundColor": "nw-hover"
          }
        },
        "focused": {
          "styles": {
            "backgroundColor": "nw-primary-soft",
            "shadowSpreadRadius": 0,
            "shadowBlurRadius": 0
          }
        }
      }
    },
    "nw-search": {
      "inherit": "button",
      "states": {
        "default": {
          "properties": {
            "font": "nw-body",
            "textColor": "nw-muted",
            "padding": [
              0,
              10
            ],
            "center": false,
            "height": 36
          },
          "styles": {
            "backgroundColor": "nw-page",
            "width": 1,
            "style": "solid",
            "color": "nw-border",
            "radius": 8
          }
        },
        "hovered": {
          "styles": {
            "backgroundColor": "nw-surface",
            "color": "nw-border-strong"
          }
        }
