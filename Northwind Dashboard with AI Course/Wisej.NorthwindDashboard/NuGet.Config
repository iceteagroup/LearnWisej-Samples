<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- A cache of its own: the local Wisej-4 keeps the released version number, so a shared cache would hand back the released build. -->
  <config>
    <add key="globalPackagesFolder" value="./.nuget-packages" />
  </config>
  <packageSources>
    <clear />
    <add key="local" value="./packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <clear />
    <packageSource key="local">
      <package pattern="Wisej-4" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
