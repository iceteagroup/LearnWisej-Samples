<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    IconDesk - Icons & Images in Wisej.NET course lab (one project per module).
    Multi-targets net10.0-windows and net10.0 (Kestrel). Run with:
      dotnet run -f net10.0 with urls http://localhost:620N   (from this folder; N = module number)

    Wisej-4 is pinned to 4.1.4 because the official icon packs used from Module 4 on
    depend on it; 4.1.0 causes a NU1605 package downgrade error.
  -->
  <PropertyGroup>
    <TargetFrameworks>net10.0-windows;net10.0</TargetFrameworks>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EmbeddedResourceUseDependentUponConvention>true</EmbeddedResourceUseDependentUponConvention>
    <RootNamespace>IconDesk</RootNamespace>
    <NoWarn>CA1416;WFO1000;CS7022</NoWarn>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Content Update="Default.json">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Content>
    <Content Update="Web.config">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <None Remove="Default.html" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Default.html">
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
    <!-- Files the browser fetches by relative URL, so they must sit beside the application. -->
    <Content Include="Images\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
    <!--
      A separate folder for the one asset the gallery reaches through an absolute URL. It is
      served by this application on purpose: the lab needs a real absolute address that answers
      on a machine with no outbound access, and "another host" is a property of the URL, not of
      where the bytes happen to live.
    -->
    <Content Include="cdn\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Wisej-4" Version="4.1.4" />
  </ItemGroup>

  <ItemGroup>
    <!--
      One official icon pack, referenced here so the gallery has a real resource.wx source to
      show. Module 4 adds a second one and compares them.
    -->
    <PackageReference Include="Wisej-4-MaterialDesign" Version="4.1.4" />
  </ItemGroup>

</Project>
