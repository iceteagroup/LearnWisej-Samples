<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    IntegrationLab — Application Integration Course, Module 8 lab
    (Data Endpoints: Postback, WebRequest & WebMethod).
    Single target (net10.0, Kestrel). Run with:  dotnet run (from this folder), port 5078 in launchSettings.json
  -->
  <PropertyGroup>
    <TargetFrameworks>net10.0-windows;net10.0</TargetFrameworks>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EmbeddedResourceUseDependentUponConvention>true</EmbeddedResourceUseDependentUponConvention>
    <RootNamespace>IntegrationLab</RootNamespace>
    <NoWarn>CA1416;WFO1000</NoWarn>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- The client adapters ship inside the assembly: the server hands them to the widgets as InitScript. -->
    <EmbeddedResource Include="wwwroot\grid-init.js" LogicalName="IntegrationLab.wwwroot.grid-init.js" />
    <EmbeddedResource Include="wwwroot\lookup-init.js" LogicalName="IntegrationLab.wwwroot.lookup-init.js" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="Default.json">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Content>
    <Content Update="Web.config">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <None Remove="Default.html" />
    <None Remove="favicon.ico" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Default.html">
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Wisej-4" Version="4.1.0" />
  </ItemGroup>

</Project>
