<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    IntegrationLab — Application Integration Course, Module 3 lab
    (Rapid Widget Integration with Wisej.Web.Widget).
    Single target (net10.0, Kestrel). Run from this folder:  dotnet run  (port 5073, see Properties/launchSettings.json)
  -->
  <PropertyGroup>
    <TargetFrameworks>net10.0-windows;net10.0</TargetFrameworks>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EmbeddedResourceUseDependentUponConvention>true</EmbeddedResourceUseDependentUponConvention>
    <RootNamespace>IntegrationLab</RootNamespace>
    <NoWarn>CA1416;WFO1000</NoWarn>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!--
      The two InitScripts ship inside the assembly: the page reads them as embedded resources
      and hands them to each Widget as InitScript. The logical name is the string passed to
      EmbeddedScript.Read(...) in DashboardPage.Designer.cs.
      The vendor libraries and stylesheets (Packages) are NOT embedded: they are served as static
      files from wwwroot/ (Startup.cs → UseFileServer) and referenced as "wwwroot/xxx".
    -->
    <EmbeddedResource Include="wwwroot\gauge-init.js" LogicalName="IntegrationLab.wwwroot.gauge-init.js" />
    <EmbeddedResource Include="wwwroot\knob-init.js" LogicalName="IntegrationLab.wwwroot.knob-init.js" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="Default.json">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Content>
    <Content Update="Web.config">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <None Remove="Default.html" />
    <None Remove="favicon.ico" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Default.html">
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Wisej-4" Version="4.1.0" />
  </ItemGroup>

</Project>
